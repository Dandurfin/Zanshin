// ============================================================================
// Steam depot build script - Zanshin DojoSync
//
// Toto je STVOR miesto, kam doplnis svoje cislo appky. Vsetko oznacene
// PLACEHOLDER musis nahradit hodnotami z partner.steamgames.com PRED tym,
// nez to spustis - inak steamcmd zlyha s "invalid appid".
//
// Spustenie (na Windows, po prihlaseni do Steamworks):
//   steamcmd +login <tvoj_partner_ucet> +run_app_build ".\steam\app_build.vdf" +quit
//
// Predtym musi existovat build appky:  pyinstaller ZanshinDojoSync_steam.spec
// (vytvori dist\ZanshinDojoSync\ - na ten ukazuje depot nizsie)
// ============================================================================

"AppBuild"
{
    "AppID" "0000000"          // PLACEHOLDER: App ID zo Steamworks
    "Desc"  "Zanshin alpha 0.1"   // popis buildu (vidno v Steamworks)
    // POZN: drz toto cislo v sulade s MyAppVersion v Dandurf.iss,
    // 'app.version_short' v i18n.py (titulna lista) a version_info.txt
    // (metadata .exe). Predtym tu stalo "0.5 - alpha", kym lista a
    // instalator uz hlasili 1.0 - tri rozne cisla pre jeden build.

    // Kam steamcmd odklada logy a medzivysledky. Relativne k tomuto suboru.
    "BuildOutput" ".\output\"

    // Korenovy priecinok obsahu - sem ukazuju cesty v depote nizsie.
    "ContentRoot" "..\dist\ZanshinDojoSync\"

    "Depots"
    {
        "0000001"             // PLACEHOLDER: Depot ID zo Steamworks
        {
            "FileMapping"
            {
                // Cely priecinok onedir buildu (exe + kniznice + assets),
                // vratane podpriecinkov.
                "LocalPath" "*"
                "DepotPath" "."
                "recursive" "1"
            }
            // Ziadne subory nevynechavame - onedir build je uz cisty.
        }
    }
}
