# ── Python / test caches ──────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/

# ── Build & packaging output ──────────────────────────────────────────
build/
dist/
installer/
steam/output/
*.spec.bak
# safety net: never commit a PyInstaller onedir output tree or loose binaries
ZanshinDojoSync/
Zanshin/
*.exe
*.dll
*.pyd

# ── Steam dev files (never in a public repo / depot) ──────────────────
steam_appid.txt

# ── Personal player data (settings, voice, recordings) ────────────────
# When run FROM SOURCE the app writes straight here, not to %APPDATA% (only
# the packaged build does — see paths.data_dir()). Do not delete these files,
# just keep them out of git and the Steam depot.
# incl. .backup, .*.bak, _..onboarding_hidden.json:
*dandurf_settings*.json
dandurf_settings.json.*
audio/tts_cache/*.mp3
audio/ukazky/
# recorded slot audio = the author's personal voice recordings (old slot{n}.wav
# naming, before voice_{uid}.wav) — NOT shipped defaults:
audio/slot*.wav
# today's recordings and picked sounds: audio/voice_<uid>.wav, audio/rec_<uid>.wav,
# audio/pick_<uid>.<ext> — nothing in audio/ belongs in git:
audio/

# ── Heart-rate session data & analysis (personal HEALTH data) ─────────
hr_sessions.json
hr_insights.json
hr_windows.json
hr_windows.json.*
hr_events*.jsonl
*.jsonl
# exported HR session tables (with lifestyle notes):
docs/*relacie*.csv
# every sibling of the health-data files (.bak, .corrupt-<time>, .tmp,
# .pred-importom-<time>.bak) and the app's default export names:
hr_*.json*
hr_*.jsonl*
*.bak
*.corrupt-*
*.tmp
zanshin-*.csv
zanshin-export*.json

# ── Personal data backups (never commit) ──────────────────────────────
zaloha_dat_*/
_zalohy_povodne/
_backup_before_refactor_*/
*.pred-*
*.docasne_odlozene

# ── Logs, screenshots, diagnostics (regenerated at runtime) ───────────
logs/
gui_test_report.txt
_diag_*.txt
icon_preview.png

# ── Generated assets ──────────────────────────────────────────────────
zen_audio/

# ── Internal working notes ───────────────────────────────────────────────
# The author's working notes are kept out locally (.git/info/exclude),
# so their names aren't listed here.
# large design mockups (HTML):
*.html

# ── Backups of originals ──────────────────────────────────────────────
*_original.py.txt
*_original.iss.txt
# Archiv: stare/nepouzivane subory presunute z repa (0.2) - ostavaju na disku ako historia, nejdu na GitHub
_archiv/
# Any table or log a session could leave in the project folder (exports are
# personal health data; logs name files and devices):
*.csv
*.log
